flowchart TD
    subgraph STEP1["<b>STEP 1 generate samplesheet</b>"]
        A["<b>A) pypette</b>"] --> S1
        Bn["<b>B) GEO/SRA download</b><br/>set <code>geo_download.accession</code>, then<br/><code>snakemake --sdm conda -p geo_samplesheet</code>"] --> S1
        En["<b>C) ENA download</b><br/>set <code>ena_download.project</code>, then<br/><code>snakemake --sdm conda -p ena_samplesheet</code>"] --> S1
        Cn["<b>D) hand-written</b>"] --> S1

        S1["Generation of the<br/>samplesheet (samples.csv)"]
    end

    S1 --> S2["<b>Edit config.yaml</b><br/>(samples_csv → generated samplesheet, organism, cellbender, ...)"]

    S2 --> S4["<b>STEP 2</b><br/><code>snakemake --sdm conda -p seurat_preprocessing</code>"]

    S4 --> QC_Loop

    subgraph QC_Loop ["<b>QC Threshold Tuning Loop (Optional)</b>"]
        direction LR
        S3["<b>Edit LUT_QC</b><br/>per-sample thresholds + doublet flag + sample to keep"]

        S5["<b>STEP 3</b><br/><code>snakemake --sdm conda -p seurat_plotQCthr</code>"]

        S3 --> S5
        S5 --> S3
    end

    QC_Loop --> Metadata_Box

    subgraph Metadata_Box ["<b>Edit metadata</b>"]
        S6["<b>Edit meta_annotation.yaml</b><br/>(title, run_label, experiment_name, study_context)<br/><b>Edit metadata.csv</b><br/>(sample annotations used for plotting)"]
    end

    S6 --> S7["<b>STEP 4</b><br/><b>w/o report:</b> <code>snakemake --sdm conda -p seurat_analysis</code><br/><b>w report:</b> <code>snakemake --sdm conda -p seurat_analysis_report</code>"]
